digraph G {
 graph [rankdir=TB,bgcolor="white",pad=".3",nodesep=".35",ranksep=".35"];
 node [shape=box,style="rounded,filled",fillcolor="#f4efec",color="#315d50",fontname="Helvetica",fontsize=13,margin=".2,.15"];
 edge [fontname="Helvetica",fontsize=10,color="#6c7e73"];
 browser [label="STUDENT INTERFACE
HTML5 / CSS3 / JS
Chat log, quick replies, labels, source panel, human route"];
 s1 [label="S1 SAFEGUARD
Length, scope, context checks"];
 s2 [label="S2 TRANSPARENCY
Lexical retriever: rule + source + similarity score",penwidth=2];
 s3 [label="S3 PROMPT BUILDER
One retrieved rule, no rewrite, JSON, text label"];
 s4 [label="S4 SAFEGUARD
Backend LLM client: 10 seconds + one retry
OR explicitly labelled deterministic local mode"];
 s5 [label="S5 TRANSPARENCY
Exact extractive JSON validator
Reject unsupported rule ID or content",penwidth=2];
 s6 [label="S6 TRANSPARENCY
Compose evidence + label + hint + uncertainty",penwidth=2];
 data [shape=cylinder,label="DATASET
40 fictional cases
APA / MLA / IEEE / university guidance"];
 api [label="HOSTED API
Gemini or OpenAI
Server-side .env key only"];
 log [shape=cylinder,label="POST /feedback
Category-only local ratings
No drafts or session IDs persisted"];
 eval [label="EVALUATION
40 labelled fixture prompts
Saved outputs + honest test limits"];
 health [label="GET /health
Mode + configuration + counts
Never exposes secrets"];
 browser -> s1 [label="POST /chat"];s1 -> s2 -> s3 -> s4 -> s5 -> s6;
 data -> s2 [label="lookup"];s4 -> api [label="Configured live mode"];api -> s4 [label="JSON response"];
 s6 -> browser [label="JSON + evidence",constraint=false]; browser -> log [style=dashed];browser -> health [style=dashed]; eval -> s1 [style=dashed,label="TestClient"];
}