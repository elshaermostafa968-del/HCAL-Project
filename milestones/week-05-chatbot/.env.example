# local = deterministic dataset feedback, no key and no external requests.
# Real-model evidence requires gemini or openai AND a working key.
LLM_PROVIDER=local
GEMINI_API_KEY=
# Use a text model available to YOUR project. Model availability changes.
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: FEEDBACK_PATH=/absolute/path/feedback.jsonl
